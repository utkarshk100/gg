# Required: your Anthropic API key (used by the backend only — never sent to the browser)
ANTHROPIC_API_KEY=

# Required in production, recommended in dev: a long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-4-5
# PORT=3001
# DATABASE_FILE=./data/postflow.db
