{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postflow",
  "main": "server/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // The React build is served as static assets. Unknown paths fall back to
  // index.html so client-side routes like /voice work on refresh.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "postflow",
      // Replace with the id printed by `npx wrangler d1 create postflow`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Per-key limits enforced by Cloudflare: logins/signups per IP, AI calls per user.
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "AI_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],

  "vars": {
    "ANTHROPIC_MODEL": "claude-sonnet-4-5"
  },

  "observability": { "enabled": true }
}
